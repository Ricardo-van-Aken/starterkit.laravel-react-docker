# This .env is used for local development and testing locally or on runners.

#################################################
###                                           ###
###   Required by docker-compose.yml only.    ###
###                                           ###
#################################################

IMAGE_REPO=local/starterkit.laravel-react-docker
TAG_ADDITION=latest

# Domain used by nginx and cert_local for SSL certificate generation
APP_DOMAIN=nginx
DOMAIN_EMAIL=

# Build target used for the laravel app container
LARAVEL_VARIANT=dev

# .env filename to be mounted in the app container
ENV_FILE=./services/laravel/.env.local
