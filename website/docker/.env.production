# This .env is used for production.

#################################################
###                                           ###
###   Required by docker-compose.yml only.    ###
###                                           ###
#################################################

IMAGE_REPO=zeepaardje/starterkit.laravel-react-docker
TAG_ADDITION=production

# Comma-separated domains used by nginx and certbot for SSL certificate generation eg zeepaardje.xyz,www.zeepaardje.xyz
APP_DOMAIN=zeepaardje.xyz,www.zeepaardje.xyz
DOMAIN_EMAIL=jtbuter@gmail.com

# Build target used for the laravel app container
BUILD_TARGET=volume-prod

# .env filename to be mounted in the app container
ENV_FILE=.env.prod

# Directory which contains the laravel app files, relative to docker-compose. These files will be mounted into nginx
# and app container. Can be either a volume or bindmount.
APP_FILES_DIR=app_files
